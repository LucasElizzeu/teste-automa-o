# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o Git (ver .gitignore).
# =============================================================================

# -------------------------
# Telegram
# -------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -------------------------
# Grafana
# -------------------------
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
# Opcional: caminho relativo da tela de login, se nao estiver no config.yaml
GRAFANA_LOGIN_URL=

# -------------------------
# Flowbix
# -------------------------
FLOWBIX_USERNAME=
FLOWBIX_PASSWORD=
FLOWBIX_LOGIN_URL=

# -------------------------
# Comportamento
# -------------------------
# false => abre o navegador visivel (util para depurar seletores)
HEADLESS=true

# Sobrescreve o config.yaml se definido
TZ=America/Manaus
LOG_LEVEL=INFO

# -------------------------
# Retencao
# -------------------------
SCREENSHOT_RETENTION_DAYS=7
